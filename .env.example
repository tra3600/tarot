TELEGRAM_BOT_TOKEN=
# demo (paiement simulé) | stars (Étoiles Telegram, services numériques, sans jeton) | provider (fournisseur BotFather).
# Vide = demo, ou provider si PAYMENT_PROVIDER_TOKEN est renseigné.
PAYMENT_MODE=demo
PAYMENT_PROVIDER_TOKEN=
# Prix en Étoiles (mode stars)
PRICE_FLASH_STARS=75
PRICE_TRIO_STARS=180
PRICE_COMPLET_STARS=330

# Mentions obligatoires des CGV : requises dès que PAYMENT_PROVIDER_TOKEN est renseigné.
BUSINESS_NAME=
BUSINESS_SIRET=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
MEDIATOR=

# 0 = ne pas envoyer l'image des cartes (texte seul)
SEND_IMAGES=1
